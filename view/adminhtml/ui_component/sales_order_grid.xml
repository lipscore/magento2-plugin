<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <listingToolbar name="listing_top">
        <massaction name="listing_massaction">
            <action name="lipscore_schedule_invitations" class="Lipscore\RatingsReviews\Ui\Component\MassAction\ScheduleInvitations">
                <settings>
                    <confirm>
                        <message translate="true">Schedule Lipscore invitations for the selected orders? Invitations are scheduled regardless of the order status, also for canceled or closed orders. Orders with an invitation already scheduled by this extension (since version 2.3.0) are skipped. Lipscore sends the invitations to the customers later.</message>
                        <title translate="true">Schedule Lipscore invitations</title>
                    </confirm>
                    <url path="lipscore/order/scheduleInvitations"/>
                    <type>lipscore_schedule_invitations</type>
                    <label translate="true">Schedule Lipscore invitations</label>
                </settings>
            </action>
        </massaction>
    </listingToolbar>
    <columns name="sales_order_columns">
        <column name="lipscore_invitation_status" component="Magento_Ui/js/grid/columns/select" sortOrder="250">
            <settings>
                <filter>select</filter>
                <options class="Lipscore\RatingsReviews\Model\System\Config\Source\Order\InvitationStatus"/>
                <dataType>select</dataType>
                <label translate="true">Lipscore Invitation</label>
            </settings>
        </column>
        <column name="lipscore_invitation_date" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="251">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Lipscore Invitation Date</label>
                <visible>false</visible>
            </settings>
        </column>
    </columns>
</listing>
