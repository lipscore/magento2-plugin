<?xml version="1.0"?>
<ruleset name="Lipscore RatingsReviews">
    <description>Magento2 coding standard for the Lipscore RatingsReviews module.</description>

    <file>.</file>

    <exclude-pattern>*/dev-tools/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>

    <arg name="extensions" value="php,phtml"/>
    <arg value="sp"/>

    <rule ref="Magento2"/>
</ruleset>
